load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "agent_computer_core",
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "core_contracts_test",
    size = "small",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/core_contracts.rs",
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    deps = [":core"],
)
