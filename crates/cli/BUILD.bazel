load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "agent-computer",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
    deps = ["//crates/core", "//crates/definitions"] + all_crate_deps(normal = True),
)

rust_test(
    name = "cli_contracts_test",
    size = "small",
    srcs = ["tests/cli_contracts.rs"],
    compile_data = ["//examples:research.computer.yaml"],
    data = [":agent-computer"],
    rustc_env = {"AGENT_COMPUTER_BIN": "$(rootpath :agent-computer)"},
    edition = "2024",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "remote_contracts_test",
    size = "small",
    srcs = ["tests/remote_contracts.rs"],
    data = [":agent-computer"],
    rustc_env = {"AGENT_COMPUTER_BIN": "$(rootpath :agent-computer)"},
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "remote_service_test",
    size = "large",
    srcs = ["tests/remote_service.rs", "tests/support/runtime.rs"],
    crate_root = "tests/remote_service.rs",
    data = [":agent-computer"],
    rustc_env = {"AGENT_COMPUTER_BIN": "$(rootpath :agent-computer)"},
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    tags = ["requires-postgresql"],
    deps = ["//crates/core", "//crates/definitions", "//crates/server", "//crates/store", "//crates/test-support"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)
