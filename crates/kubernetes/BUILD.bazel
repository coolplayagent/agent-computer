load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "kubernetes",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "agent_computer_kubernetes",
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
    deps = ["//crates/definitions"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "kubernetes_contracts_test",
    size = "small",
    crate = ":kubernetes",
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "kubernetes_live_test",
    size = "medium",
    srcs = ["tests/live.rs"],
    tags = ["manual", "requires-kubernetes"],
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    deps = [":kubernetes", "//crates/definitions"] + all_crate_deps(normal = True, normal_dev = True),
)
