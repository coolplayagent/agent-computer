load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "watchdog",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_name = "agent_computer_watchdog",
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_binary(
    name = "agent-computer-watchdog",
    srcs = ["src/main.rs"],
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
    deps = [":watchdog"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "watchdog_contracts_test",
    size = "small",
    crate = ":watchdog",
)
