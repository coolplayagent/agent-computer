load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "definitions",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "agent_computer_definitions",
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
    deps = ["//crates/core"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "definitions_contracts_test",
    size = "small",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/definitions_contracts.rs",
    compile_data = [
        "//examples:research.computer.yaml",
        "//schemas:computer-set-v1alpha1.json",
    ],
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    deps = [":definitions"] + all_crate_deps(normal = True),
)
