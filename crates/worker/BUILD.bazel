load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "worker",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "agent_computer_worker",
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
    deps = ["//crates/core", "//crates/definitions", "//crates/kubernetes", "//crates/store", "//crates/storage", "//crates/node", "//crates/watchdog"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "volume_worker_live_test",
    size = "large",
    srcs = ["tests/live.rs"],
    tags = ["manual", "requires-kubernetes", "requires-postgresql"],
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    deps = [":worker", "//crates/core", "//crates/definitions", "//crates/kubernetes", "//crates/store", "//crates/test-support"] + all_crate_deps(normal = True, normal_dev = True),
)

rust_test(
    name = "execution_worker_live_test",
    size = "large",
    srcs = ["tests/execution_live.rs", "tests/support/execution_faults.rs"],
    crate_root = "tests/execution_live.rs",
    tags = ["manual", "requires-kubernetes", "requires-postgresql", "requires-juicefs"],
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    deps = [":worker", "//crates/core", "//crates/definitions", "//crates/kubernetes", "//crates/store", "//crates/watchdog"] + all_crate_deps(normal = True, normal_dev = True),
)

rust_test(
    name = "candidate_worker_live_test",
    size = "large",
    srcs = ["tests/candidate_live.rs", "tests/support/file_writer.rs", "tests/support/file_http.rs"],
    crate_root = "tests/candidate_live.rs",
    tags = ["manual", "requires-kubernetes", "requires-postgresql", "requires-juicefs"],
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    deps = [":worker", "//crates/core", "//crates/definitions", "//crates/kubernetes", "//crates/storage", "//crates/store"] + all_crate_deps(normal = True, normal_dev = True),
)
