load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "node",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "agent_computer_node",
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
    deps = ["//crates/browser", "//crates/fence", "//crates/kubernetes", "//crates/watchdog"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "node_contracts_test",
    size = "small",
    crate = ":node",
)

rust_test(
    name = "browser_live_test",
    size = "large",
    srcs = ["tests/browser_live.rs"],
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    tags = ["manual", "requires-root", "requires-kubernetes"],
    deps = [":node", "//crates/browser", "//crates/definitions", "//crates/kubernetes", "//crates/watchdog"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)
