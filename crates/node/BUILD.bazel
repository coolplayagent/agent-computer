load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "node",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "agent_computer_node",
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
    deps = ["//crates/fence", "//crates/kubernetes", "//crates/watchdog"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "node_contracts_test",
    size = "small",
    crate = ":node",
)
